# 应用配置
APP_NAME=Law GPT
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DATABASE_URL=postgresql://root:zqdl%402025@localhost:5432/law_gpt

# Redis配置
REDIS_URL=redis://:redis@zqdl@localhost:6379/0
REDIS_CACHE_TTL=3600

# AI模型配置
LLM_SERVICE_URL=http://localhost:32778
VLLM_MODEL_PATH=/vllm/models/Qwen3-8B  # 容器内的模型路径
VLLM_MODEL_NAME=Qwen3-8B  # 模型名称
EMBEDDING_MODEL_PATH=/docker_share/HP_SSD2/vllm_docker_model/qwen3-embedding-0.6b
MAX_TOKENS=2048
TEMPERATURE=0.1

# FAISS配置 - 使用目录路径，代码中会自动添加文件名
FAISS_INDEX_PATH=./data/faiss_index
EMBEDDING_DIMENSION=768

# 文档处理配置
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MAX_DOCUMENT_SIZE=10485760

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 安全配置
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# RAG框架选择
RAG_FRAMEWORK=advanced# 可选: langchain, llamaindex ,advanced
VECTOR_STORE_TYPE=milvus# 可选: faiss, milvus

# Milvus配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=law_documents

# 添加GPU设备配置
CUDA_VISIBLE_DEVICES=2
CUDA_DEVICE_ORDER=PCI_BUS_ID

